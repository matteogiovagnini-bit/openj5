{
  "node": {
    "id": "node7",
    "name": "balance_controller",
    "type": "balance",
    "hardware": "esp32s3_devkit",
    "firmware": "openj5-node7-balance",
    "version": "1.0.0"
  },
  "network": {
    "wifi": {
      "ssid_env": "OPENJ5_WIFI_SSID",
      "password_env": "OPENJ5_WIFI_PASSWORD",
      "static_ip": null,
      "hostname": "openj5-balance"
    },
    "mqtt": {
      "host_env": "OPENJ5_MQTT_HOST",
      "port": 8883,
      "tls": true,
      "ca_cert": "certs/ca.crt",
      "client_cert": "certs/node7.crt",
      "client_key": "certs/node7.key",
      "client_id": "openj5-node7-balance",
      "keepalive": 60,
      "topic_prefix": "openj5/v1/balance"
    }
  },
  "stepper_driver": {
    "type": "a4988",
    "config": {
      "a4988": {
        "balance_joint": {
          "step_pin": 4,
          "dir_pin": 5,
          "enable_pin": 6,
          "microsteps": 16,
          "rms_current_ma": 550,
          "stall_detect": false
        }
      }
    }
  },
  "steppers": [
    {
      "id": "balance_joint",
      "type": "nema17",
      "steps_per_rev": 200,
      "microsteps": 16,
      "gear_ratio": 4.0,
      "inverted": false,
      "max_speed_steps_s": 1600,
      "max_accel_steps_s2": 800,
      "limits": {
        "min_steps": -4445,
        "max_steps": 4445,
        "max_velocity_steps_s": 1600,
        "max_acceleration_steps_s2": 800
      }
    }
  ],
  "imu": {
    "type": "mpu6050",
    "i2c_bus": 1,
    "address": 104,
    "sample_rate_hz": 200,
    "fusion": "madgwick",
    "mount": "body"
  },
  "balance": {
    "target_pitch_deg": 0.0,
    "max_tilt_deg": 35.0,
    "deadband_deg": 0.5,
    "control_hz": 100,
    "imu_sample_hz": 200,
    "reference": "gravity",
    "enabled_on_boot": false,
    "pid": {
      "kp": 15.0,
      "ki": 1.0,
      "kd": 0.3,
      "output_min": -1600,
      "output_max": 1600,
      "integral_min": -4000,
      "integral_max": 4000
    }
  },
  "motion_primitives": {
    "level": {
      "parameters": {
        "target_pitch_deg": { "type": "float", "min": -90.0, "max": 90.0, "default": 0.0 }
      },
      "implementation": "gravity_leveling_pid"
    },
    "tilt": {
      "parameters": {
        "angle_deg": { "type": "float", "min": -35.0, "max": 35.0, "default": 0.0 },
        "speed": { "type": "float", "min": 0.05, "max": 1.0, "default": 0.5 }
      },
      "implementation": "position_control_trapezoid"
    },
    "stow": {
      "parameters": [],
      "implementation": "position_control_trapezoid_to_zero"
    },
    "stop": {
      "parameters": [],
      "implementation": "brake_hold",
      "priority": "critical"
    }
  },
  "safety": {
    "max_tilt_deg": 35.0,
    "hard_stop_deceleration": 4.0,
    "deadman_timeout_ms": 250,
    "watchdog_timeout_ms": 1000,
    "disable_on_error": true,
    "enable_on_boot": false
  }
}