# Robot Core Service Dockerfile
FROM python:3.11-slim-bookworm

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    # OpenCV dependencies
    libgl1 libglib2.0-0 libsm6 libxext6 libxrender1 libgomp1 \
    # Build tools for any pip packages needing compilation
    build-essential \
    # Certificates for MQTT TLS
    ca-certificates \
    # Healthcheck HTTP client
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set up Python environment
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY src/ ./src/
COPY config/ ./config/

# Create non-root user with fixed uid/gid 1000 (matches the host user that
# owns ./certs private keys; bind-mounted 640 keys need matching uid/gid)
RUN groupadd -g 1000 openj5 \
    && useradd -u 1000 -g 1000 -d /app -s /bin/bash openj5 \
    && chown -R openj5:openj5 /app

# Create required directories (compose mounts named volumes on these paths;
# do NOT declare VOLUME here - with the containerd image store a declared
# volume plus a compose named volume on the same path fails as read-only)
RUN mkdir -p /var/log/openj5 /etc/openj5/certs /opt/openj5/firmware /opt/openj5/plugins \
    && chown -R openj5:openj5 /var/log/openj5 /etc/openj5 /opt/openj5

# Switch to non-root user
USER openj5

# Expose ports
EXPOSE 8080 8081

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Entry point
ENTRYPOINT ["python", "-m", "robot_core.__main__"]