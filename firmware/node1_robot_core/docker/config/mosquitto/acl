# OpenJ5 Mosquitto ACL
# Pattern-based access control for robot topics

# Robot Core (node1) has full access
user node1
topic readwrite openj5/#
topic readwrite $SYS/#

# Head node (node2) - control and status
user node2
topic readwrite openj5/node2/#
topic read openj5/node1/commands/#

# Right arm node (node3)
user node3
topic readwrite openj5/node3/#
topic read openj5/node1/commands/#

# Left arm node (node4)
user node4
topic readwrite openj5/node4/#
topic read openj5/node1/commands/#

# Torso node (node5)
user node5
topic readwrite openj5/node5/#
topic read openj5/node1/commands/#

# Tracks node (node6)
user node6
topic readwrite openj5/node6/#
topic read openj5/node1/commands/#

# ROS2 bridge
user rosbridge
topic readwrite openj5/#

# Monitoring
user monitoring
topic read openj5/#
topic read $SYS/#

# API user
user api
topic readwrite openj5/#

# Deny all other users
user anonymous
# $SYS/broker/version is a static topic: delivered once, immediately on
# subscription, so the container healthcheck gets a reply within its window.
# ($SYS/broker/uptime no longer exists in mosquitto 2.0.)
topic read $SYS/broker/version
topic deny openj5/#
topic deny $SYS/#
